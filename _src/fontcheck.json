[
 {
  "text": "导读 / 阅读契约",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "02 / 95",
  "fonts": [
   "Times New Roman",
   "Times New Roman",
   "Times New Roman"
  ]
 },
 {
  "text": "先把“假”放下",
  "fonts": [
   "仿宋",
   "仿宋",
   "仿宋"
  ]
 },
 {
  "text": "这不是一份需要背诵的教材，而是一部由学生写成的戏",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "经典的句法、庄重的文言，记录一所学校里被反复讲述",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "01",
  "fonts": [
   "Times New Roman",
   "Times New Roman",
   "Times New Roman"
  ]
 },
 {
  "text": "不作人身指认",
  "fonts": [
   "仿宋",
   "仿宋",
   "仿宋"
  ]
 },
 {
  "text": "文中的“徐规尔”“水蛭”是叙述者建构的讽刺形象。",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "对写法与经验，不针对现实个人。",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "02",
  "fonts": [
   "Times New Roman",
   "Times New Roman",
   "Times New Roman"
  ]
 },
 {
  "text": "不把戏谑当事实",
  "fonts": [
   "仿宋",
   "仿宋",
   "仿宋"
  ]
 },
 {
  "text": "夸张、传闻、诅咒是文本策略，不等于证据。读它，要",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "了什么”和“为何这样说”。",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "03",
  "fonts": [
   "Times New Roman",
   "Times New Roman",
   "Times New Roman"
  ]
 },
 {
  "text": "不只看热闹",
  "fonts": [
   "仿宋",
   "仿宋",
   "仿宋"
  ]
 },
 {
  "text": "笑过之后，追问它为什么笑、笑给谁看、笑完剩下什么",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "“语言是思维的边界，语",
  "fonts": [
   "仿宋",
   "仿宋",
   "仿宋"
  ]
 },
 {
  "text": "言是创造的源头。”",
  "fonts": [
   "仿宋",
   "仿宋",
   "仿宋"
  ]
 },
 {
  "text": "—— 编者的话",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "把这句话放在第一页，是因为整本书的褒贬都",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "从这里出发：语言究竟用来连接人，还是用来",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "设门槛。",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "《蛭文》教学读本 / 文本细读与写作",
  "fonts": [
   "华文中宋",
   "华文中宋",
   "华文中宋"
  ]
 },
 {
  "text": "02",
  "fonts": [
   "Times New Roman",
   "Times New Roman",
   "Times New Roman"
  ]
 }
]